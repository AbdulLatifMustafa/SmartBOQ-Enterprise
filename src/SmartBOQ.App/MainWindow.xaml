<Window x:Class="SmartBOQ.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:SmartBOQ.App.ViewModels"
        xmlns:views="clr-namespace:SmartBOQ.App.Views"
        mc:Ignorable="d"
        Title="SmartBOQ Enterprise - BOQ Reconciliation &amp; Pricing Engine"
        Width="1320" Height="860" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgDark}"
        FlowDirection="{Binding UiFlowDirection}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Responsive Content Area -->
            <RowDefinition Height="*"/>
            <!-- Status & Footer Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER & NAVIGATION BAR                                    -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Title & Tagline -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushPrimary}" CornerRadius="8" Width="40" Height="40" Margin="0,0,14,0">
                        <iconPacks:PackIconLucide Kind="Calculator" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SmartBOQ" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text=" Enterprise" FontWeight="Light" FontSize="19" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </StackPanel>
                        <TextBlock Text="Engine v2.0 • 100% Offline Air-Gapped" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs (Simplified, Responsive & High Visibility) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Tab 1: ملخص المشروع -->
                    <RadioButton x:Name="TabBtn0" GroupName="NavTabs" IsChecked="True"
                                 Click="NavTab_Summary_Click"
                                 Style="{StaticResource NavTabStyle}" 
                                 >
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="LayoutDashboard" Width="17" Height="17" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding TabSummary}" FontWeight="SemiBold" FontSize="13.5"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 2: مقارنة الملفات -->
                    <RadioButton x:Name="TabBtn1" GroupName="NavTabs" Click="NavTab_Compare_Click"
                                 Style="{StaticResource NavTabStyle}" 
                                 >
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Files" Width="17" Height="17" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding TabCompare}" FontWeight="SemiBold" FontSize="13.5"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 3: جدول التسعير -->
                    <RadioButton x:Name="TabBtn2" GroupName="NavTabs" Click="NavTab_Pricing_Click"
                                 Style="{StaticResource NavTabStyle}" 
                                 >
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Table" Width="17" Height="17" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding TabPricingGrid}" FontWeight="SemiBold" FontSize="13.5"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 4: أسعار المشاريع -->
                    <RadioButton x:Name="TabBtn3" GroupName="NavTabs" Click="NavTab_Rates_Click"
                                 Style="{StaticResource NavTabStyle}" 
                                 >
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Database" Width="17" Height="17" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding TabProjectRates}" FontWeight="SemiBold" FontSize="13.5"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 5: تصدير الملف -->
                    <RadioButton x:Name="TabBtn4" GroupName="NavTabs" Click="NavTab_Export_Click"
                                 Style="{StaticResource NavTabStyle}" 
                                 >
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Download" Width="17" Height="17" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding TabExport}" FontWeight="SemiBold" FontSize="13.5"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Language Switcher, Theme Switcher & Offline Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Subtle Cohesive Offline Badge -->
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ShieldCheck" Width="14" Height="14" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LblOfflineBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Theme Switcher (Dark / Light Mode) -->
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource SecondaryBtn}" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{Binding ThemeIcon}" Width="15" Height="15" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ThemeText}" FontSize="12.5" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Language Switcher Button -->
                    <Button Command="{Binding ToggleLanguageCommand}" Style="{StaticResource SecondaryBtn}" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Languages" Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentLanguageCode}" FontSize="12.5" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- MAIN RESPONSIVE TAB CONTROLLER                            -->
        <!-- ========================================================= -->
        <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" SelectionChanged="MainTabs_SelectionChanged" BorderThickness="0" Background="Transparent" Margin="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- 1. TAB: ملخص المشروع (PROJECT SUMMARY) -->
            <TabItem>
                <views:ProjectSummaryView/>
            </TabItem>

            <!-- 2. TAB: مقارنة الملفات (FILE COMPARISON) -->
            <TabItem>
                <views:FileCompareView/>
            </TabItem>

            <!-- 3. TAB: جدول التسعير (PRICING GRID) -->
            <TabItem>
                <views:PricingTableView/>
            </TabItem>

            <!-- 4. TAB: أسعار المشاريع (PROJECT RATES & BENCHMARKS) -->
            <TabItem>
                <views:ProjectRatesView/>
            </TabItem>

            <!-- 5. TAB: تصدير الملف (EXPORT FILE) -->
            <TabItem>
                <views:ExportFileView/>
            </TabItem>
        </TabControl>

        <!-- ========================================================= -->
        <!-- BOTTOM STATUS & PROGRESS BAR                              -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="20,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconLucide Kind="Activity" Width="15" Height="15" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Progress Bar & Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="160" Height="8" Value="{Binding ProgressPercentage}" 
                                 Visibility="{Binding IsLoading, Converter={x:Null}}" 
                                 Foreground="{DynamicResource BrushPrimary}" Background="{DynamicResource BrushInputBg}" BorderThickness="0" Margin="0,0,12,0"/>
                    <TextBlock Text="SmartBOQ Engine v2.0" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
