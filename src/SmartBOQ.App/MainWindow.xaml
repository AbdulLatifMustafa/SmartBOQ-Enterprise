<Window x:Class="SmartBOQ.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:SmartBOQ.App.ViewModels"
        xmlns:views="clr-namespace:SmartBOQ.App.Views"
        mc:Ignorable="d"
        Title="SmartBOQ Enterprise - BOQ Reconciliation &amp; Pricing Engine"
        Width="1320" Height="860" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgDark}"
        FlowDirection="{Binding UiFlowDirection}"
        Icon="Resources/app.ico">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Main Content Area: Sidebar + Workspace -->
            <RowDefinition Height="*"/>
            <!-- Status & Footer Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- MAIN RESPONSIVE BODY: SIDEBAR + WORKSPACE                -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Sidebar on the side (Right side in Arabic RTL, Left in LTR) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Responsive Workspace Area (Expands across all screens) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. SIDEBAR NAVIGATION COMPONENT (شريط التنقل الجانبي) -->
            <views:AppSidebar Grid.Column="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"/>

            <!-- 2. MAIN RESPONSIVE TAB CONTROLLER -->
            <TabControl x:Name="MainTabs" Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent" Margin="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- 1. TAB: ملخص المشروع (PROJECT SUMMARY) -->
                <TabItem>
                    <views:ProjectSummaryView/>
                </TabItem>

                <!-- 2. TAB: مقارنة الملفات (FILE COMPARISON) -->
                <TabItem>
                    <views:FileCompareView/>
                </TabItem>

                <!-- 3. TAB: جدول التسعير (PRICING GRID) -->
                <TabItem>
                    <views:PricingTableView/>
                </TabItem>

                <!-- 4. TAB: أسعار المشاريع (PROJECT RATES & BENCHMARKS) -->
                <TabItem>
                    <views:ProjectRatesView/>
                </TabItem>

                <!-- 5. TAB: تصدير الملف (EXPORT FILE) -->
                <TabItem>
                    <views:ExportFileView/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ========================================================= -->
        <!-- BOTTOM STATUS & PROGRESS BAR                              -->
        <!-- ========================================================= -->
        <Border Grid.Row="1" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconLucide Kind="Activity" Width="15" Height="15" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Progress Bar & Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="160" Height="8" Value="{Binding ProgressPercentage}" 
                                 Visibility="{Binding IsLoading, Converter={x:Null}}" 
                                 Foreground="{DynamicResource BrushPrimary}" Background="{DynamicResource BrushInputBg}" BorderThickness="0" Margin="0,0,12,0"/>
                    <TextBlock Text="SmartBOQ Engine v2.0" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
