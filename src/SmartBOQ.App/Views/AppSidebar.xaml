<UserControl x:Class="SmartBOQ.App.Views.AppSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="230">

    <UserControl.Resources>
        <!-- Comfortable, Soft Vertical Sidebar Tab Item Style (Eye-Comfort, No Harsh White, No Harsh Borders) -->
        <Style x:Key="SidebarTabItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Utility Button Style -->
        <Style x:Key="SidebarToolBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Sidebar Container: Fixed width, soft background, gentle border -->
    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" Padding="14,16" Width="220">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Section Header -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Vertical Navigation Menu List (Scrollable if screen is very short) -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Utility Controls & Offline Badge -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Section Label -->
            <TextBlock Grid.Row="0" Text="القوائم الرئيسية" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,2,0,10" Opacity="0.85"/>

            <!-- Navigation Tabs List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Tab 0: ملخص المشروع -->
                    <RadioButton x:Name="TabRadio0" GroupName="SidebarNavGroup" IsChecked="True"
                                 Style="{StaticResource SidebarTabItemStyle}"
                                 Click="TabRadio_Click" Tag="0">
                        <DockPanel LastChildFill="True">
                            <iconPacks:PackIconLucide Kind="LayoutDashboard" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding TabSummary, FallbackValue='ملخص المشروع'}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>

                    <!-- Tab 1: مقارنة الملفات -->
                    <RadioButton x:Name="TabRadio1" GroupName="SidebarNavGroup"
                                 Style="{StaticResource SidebarTabItemStyle}"
                                 Click="TabRadio_Click" Tag="1">
                        <DockPanel LastChildFill="True">
                            <iconPacks:PackIconLucide Kind="GitCompare" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding TabCompare, FallbackValue='مقارنة الملفات'}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>

                    <!-- Tab 2: جدول المقايسة والأسعار -->
                    <RadioButton x:Name="TabRadio2" GroupName="SidebarNavGroup"
                                 Style="{StaticResource SidebarTabItemStyle}"
                                 Click="TabRadio_Click" Tag="2">
                        <DockPanel LastChildFill="True">
                            <iconPacks:PackIconLucide Kind="FileSpreadsheet" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding TabPricingGrid, FallbackValue='جدول المقايسة والأسعار'}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>

                    <!-- Tab 3: أسعار المشاريع -->
                    <RadioButton x:Name="TabRadio3" GroupName="SidebarNavGroup"
                                 Style="{StaticResource SidebarTabItemStyle}"
                                 Click="TabRadio_Click" Tag="3">
                        <DockPanel LastChildFill="True">
                            <iconPacks:PackIconLucide Kind="Database" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding TabProjectRates, FallbackValue='أسعار المشاريع'}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>

                    <!-- Tab 4: تصدير الملف -->
                    <RadioButton x:Name="TabRadio4" GroupName="SidebarNavGroup"
                                 Style="{StaticResource SidebarTabItemStyle}"
                                 Click="TabRadio_Click" Tag="4">
                        <DockPanel LastChildFill="True">
                            <iconPacks:PackIconLucide Kind="Download" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding TabExport, FallbackValue='تصدير الملف'}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Tools & Security Badge -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <!-- Theme and Language Buttons Grid -->
                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <!-- Theme Switcher -->
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource SidebarToolBtnStyle}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="{Binding ThemeIcon}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ThemeText}" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Language Switcher -->
                    <Button Command="{Binding ToggleLanguageCommand}" Style="{StaticResource SidebarToolBtnStyle}" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Languages" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentLanguageCode}" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Offline Security Badge (English Digits: 100%) -->
                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="ShieldCheck" Width="13" Height="13" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="نظام محلي معزول 100%" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
