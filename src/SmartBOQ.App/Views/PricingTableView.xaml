<UserControl x:Class="SmartBOQ.App.Views.PricingTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <!-- Filter & Search Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Responsive High-Contrast Virtualized DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Pagination Controls (100 Items Per Page) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Responsive Filter & Action Toolbar (Zero Scrollbars, Fully Responsive on All Displays) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Filter Badges: WrapPanel adapts dynamically to screen width without any horizontal scrollbar -->
                <ColumnDefinition Width="*"/>
                <!-- Search & Action Controls: Clean layout with guaranteed visibility -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Chips with Clear Icons (Responsive WrapPanel) -->
            <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Command="{Binding SetFilterCommand}" CommandParameter="All" Style="{StaticResource SecondaryBtn}" Padding="11,6" Margin="0,0,6,4" FontSize="12.5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ListFilter" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="الكل" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="Priced" Style="{StaticResource SecondaryBtn}" Padding="11,6" Margin="0,0,6,4" FontSize="12.5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="CheckCheck" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="البنود المسعرة" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="VO" Style="{StaticResource SecondaryBtn}" Padding="11,6" Margin="0,0,6,4" FontSize="12.5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="FilePlus" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="بنود مستحدثة (VO)" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="PS" Style="{StaticResource SecondaryBtn}" Padding="11,6" Margin="0,0,6,4" FontSize="12.5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ShieldCheck" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="مبالغ احتياطية (PS)" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="Review" Style="{StaticResource SecondaryBtn}" Padding="11,6" Margin="0,0,6,4" FontSize="12.5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="CircleAlert" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تحتاج مراجعة" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="Approved" Style="{StaticResource SecondaryBtn}" Padding="11,6" Margin="0,0,6,4" FontSize="12.5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="BadgeCheck" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="المعتمدة" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Search & Actions (Fixed & Guaranteed Layout) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <Border Width="190" Margin="0,0,8,4">
                    <Grid>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}" 
                                 Padding="30,6,10,6" FontSize="12.5"/>
                        <iconPacks:PackIconLucide Kind="Search" Width="14" Height="14" 
                                                  Foreground="{DynamicResource BrushTextSecondary}" 
                                                  HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- اعتماد الكل -->
                <Button Command="{Binding ApproveAllCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,6" Margin="0,0,8,4" FontSize="12.5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="CheckCheck" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="اعتماد الكل" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- تصدير ودمج الآن -->
                <Button Command="{Binding ExportCommand}" Style="{StaticResource ModernBtn}" Padding="14,6" Margin="0,0,0,4" FontSize="12.5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Download" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تصدير ودمج الآن" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Responsive High-Contrast Virtualized DataGrid (Precision Column-to-Cell Alignment) -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding PagedItems}" 
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="False"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  FontSize="13.5"
                  RowHeight="38"
                  Background="{DynamicResource BrushBgCard}" 
                  RowBackground="{DynamicResource BrushRowBg}" 
                  AlternatingRowBackground="{DynamicResource BrushRowAltBg}"
                  BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                  GridLinesVisibility="All" 
                  HorizontalGridLinesBrush="{DynamicResource BrushBorder}"
                  VerticalGridLinesBrush="{DynamicResource BrushBorder}"
                  EnableRowVirtualization="True" 
                  EnableColumnVirtualization="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">

            <DataGrid.Resources>
                <!-- Base Column Header Style (Dark/Light Adaptive, Centered) -->
                <Style x:Key="BaseGridColumnHeader" TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13.5"/>
                    <Setter Property="Padding" Value="8,10"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Description Column Header Style (Inherits Dark/Light Theme, Right-Aligned) -->
                <Style x:Key="RightAlignedGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource BaseGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                    <Setter Property="Padding" Value="14,10"/>
                </Style>
            </DataGrid.Resources>

            <!-- DataGrid Column Header Style -->
            <DataGrid.ColumnHeaderStyle>
                <StaticResource ResourceKey="BaseGridColumnHeader"/>
            </DataGrid.ColumnHeaderStyle>

            <!-- DataGrid Row Style with Frosted Glass Neutral Selection (Zero Blue) -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushSelectedRow}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushRowHover}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource BrushSelectedRow}"/>
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <!-- DataGrid Cell Style with Transparent Background & Clean Alignment (Zero Blue Override) -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <!-- Approved Checkbox -->
                <DataGridCheckBoxColumn Header="اعتماد" Binding="{Binding IsApproved, UpdateSourceTrigger=PropertyChanged}" Width="65">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                </DataGridCheckBoxColumn>

                <!-- Bill Name -->
                <DataGridTextColumn Header="الشيت / الباب" Binding="{Binding TargetItem.BillNumber}" Width="160" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Anchor Row Index -->
                <DataGridTextColumn Header="السطر" Binding="{Binding TargetItem.AnchorRowIndex}" Width="65" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Item Code -->
                <DataGridTextColumn Header="البند" Binding="{Binding TargetItem.ItemCode}" Width="75" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Description (Explicit width + MinWidth so it never collapses in horizontal scroll) -->
                <DataGridTextColumn Header="وصف البند" Binding="{Binding TargetItem.Description}" Width="350" MinWidth="220" IsReadOnly="True"
                                    HeaderStyle="{StaticResource RightAlignedGridColumnHeader}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding TargetItem.Description}"/>
                            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
                            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="14,0"/>
                            <Setter Property="FontSize" Value="13.5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Unit -->
                <DataGridTextColumn Header="الوحدة" Binding="{Binding TargetItem.Unit}" Width="75" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Quantity -->
                <DataGridTextColumn Header="الكمية" Binding="{Binding TargetItem.Quantity, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Currency -->
                <DataGridTextColumn Header="العملة" Binding="{Binding TargetItem.Currency}" Width="75" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Injected Rate - Price Column -->
                <DataGridTemplateColumn Header="السعر" Width="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayRateText}" 
                                       FontWeight="Bold" FontSize="13.5"
                                       HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ToolTip Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding DisplayRateText, StringFormat={}السعر المحقون: {0}}" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                            <TextBlock Text="{Binding SourceTableDisplay, StringFormat={}الجدول المصدر: {0}}" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding SourceItemCodeDisplay, StringFormat={}كود بند المصدر: {0}}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding SourceRowIndex, StringFormat={}السطر في ملف المقاول: {0}}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding DisplayConfidenceText, StringFormat={}الحالة: {0}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccess}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProvisionalSum}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsVariationOrder}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding InjectedRate, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}"
                                     Style="{StaticResource ModernTextBox}" Padding="4,2" HorizontalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Source Table & Excel Jump Column -->
                <DataGridTemplateColumn Header="جدول المقاول المصدر" Width="200" MinWidth="180" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Command="{Binding DataContext.OpenMatchedSourceLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding HasMatchedSource, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource SecondaryBtn}"
                                        Padding="5,2" Margin="0,0,6,0"
                                        ToolTip="الانتقال إلى موقع هذا البند في ملف المقاول (Excel)">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="ExternalLink" Width="10.5" Height="10.5" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="المصدر" FontSize="10.5"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding SourceTableDisplay}" 
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProvisionalSum}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsVariationOrder}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Match Score -->
                <DataGridTextColumn Header="دقة التطابق" Binding="{Binding SimilarityScore, StringFormat={}{0:P1}}" Width="100" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Confidence Status (Localized High-Visibility) -->
                <DataGridTextColumn Header="الحالة" Binding="{Binding DisplayConfidenceText}" Width="145" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Confidence}" Value="Exact">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsProvisionalSum}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVariationOrder}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ========================================================================= -->
        <!-- ROW 2: MODERN FLUENT PAGINATION BAR (100 ITEMS PER PAGE)                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <!-- Page Info / Item Count (Right side in RTL) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Layers" Width="13" Height="13" Margin="0,0,5,0" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="100 بند لكل صفحة" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding PageInfoText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Controls (Left side in RTL) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- First Page -->
                    <Button Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}" Style="{StaticResource SecondaryBtn}" Padding="8,5" Margin="0,0,4,0" ToolTip="الصفحة الأولى">
                        <iconPacks:PackIconLucide Kind="ChevronsRight" Width="14" Height="14"/>
                    </Button>
                    <!-- Previous Page -->
                    <Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}" Style="{StaticResource SecondaryBtn}" Padding="10,5" Margin="0,0,6,0" ToolTip="الصفحة السابقة">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ChevronRight" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="السابق" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Current Page Badge -->
                    <Border Background="{DynamicResource BrushSelectedRow}" BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="1" CornerRadius="6" Padding="12,5" Margin="0,0,6,0">
                        <TextBlock Text="{Binding CurrentPageDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Next Page -->
                    <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}" Style="{StaticResource SecondaryBtn}" Padding="10,5" Margin="0,0,4,0" ToolTip="الصفحة التالية">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="التالي" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"/>
                            <iconPacks:PackIconLucide Kind="ChevronLeft" Width="14" Height="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Last Page -->
                    <Button Command="{Binding LastPageCommand}" IsEnabled="{Binding CanGoToNextPage}" Style="{StaticResource SecondaryBtn}" Padding="8,5" Margin="0,0,10,0" ToolTip="الصفحة الأخيرة">
                        <iconPacks:PackIconLucide Kind="ChevronsLeft" Width="14" Height="14"/>
                    </Button>

                    <!-- Jump to Page input -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="انتقال إلى صفحة:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding JumpPageInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Width="45" Height="27" Padding="2,1" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Command="{Binding JumpToPageCommand}" Style="{StaticResource SecondaryBtn}" Padding="8,4" Height="27" Margin="4,0,0,0">
                            <TextBlock Text="ذهاب" FontSize="11.5" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
