<UserControl x:Class="SmartBOQ.App.Views.SliderNavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="1320">

    <UserControl.Resources>
        <!-- Sleek SliderBar Tab Button Style (No Blue, High Contrast, Smooth Transitions) -->
        <Style x:Key="SliderTabItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Arrow Button Style -->
        <Style x:Key="SliderArrowBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Interactive Slider Track Style for SliderBar -->
        <Style x:Key="ModernNavSliderStyle" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="{DynamicResource BrushBorder}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="10" Background="{DynamicResource BrushPrimary}" CornerRadius="5" Cursor="Hand">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Header Container -->
    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Column 0: Brand & Tagline -->
                <ColumnDefinition Width="Auto"/>
                <!-- Column 1: Interactive SliderBar Navigation Center -->
                <ColumnDefinition Width="*"/>
                <!-- Column 2: Tools (Offline, Theme, Language) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Title & Tagline -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource BrushPrimary}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                    <iconPacks:PackIconLucide Kind="Calculator" Width="19" Height="19" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SmartBOQ" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text=" Enterprise" FontWeight="Normal" FontSize="17" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    <TextBlock Text="منظومة تدقيق المقايسات الهندسية • Offline" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <!-- ================================================================= -->
            <!-- DEDICATED SLIDERBAR NAVIGATION (شريط التنقل المنزلق التفاعلي)      -->
            <!-- ================================================================= -->
            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="8,4" MaxWidth="780">
                <StackPanel>
                    <!-- Tabs Bar with Slider Controls -->
                    <DockPanel LastChildFill="True">
                        <!-- Slide Right Button (Right-To-Left Navigation) -->
                        <Button x:Name="SlideRightBtn" DockPanel.Dock="Right" Style="{StaticResource SliderArrowBtnStyle}"
                                Click="SlideRightBtn_Click" ToolTip="الانتقال لليمين">
                            <iconPacks:PackIconLucide Kind="ChevronRight" Width="16" Height="16"/>
                        </Button>

                        <!-- Slide Left Button -->
                        <Button x:Name="SlideLeftBtn" DockPanel.Dock="Left" Style="{StaticResource SliderArrowBtnStyle}"
                                Click="SlideLeftBtn_Click" ToolTip="الانتقال لليسار">
                            <iconPacks:PackIconLucide Kind="ChevronLeft" Width="16" Height="16"/>
                        </Button>

                        <!-- Horizontal Scrollable Slider Tabs -->
                        <ScrollViewer x:Name="SliderTabsScrollViewer"
                                      Style="{StaticResource MenuSliderBarStyle}"
                                      HorizontalAlignment="Center"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Hidden">
                            <StackPanel Orientation="Horizontal">
                                <!-- Tab 0: ملخص المشروع -->
                                <RadioButton x:Name="TabRadio0" GroupName="SliderNavGroup" IsChecked="True"
                                             Style="{StaticResource SliderTabItemStyle}"
                                             Click="TabRadio_Click" Tag="0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="LayoutDashboard" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TabSummary, FallbackValue='ملخص المشروع'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Tab 1: مقارنة الملفات -->
                                <RadioButton x:Name="TabRadio1" GroupName="SliderNavGroup"
                                             Style="{StaticResource SliderTabItemStyle}"
                                             Click="TabRadio_Click" Tag="1">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="GitCompare" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TabCompare, FallbackValue='مقارنة الملفات'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Tab 2: جدول المقايسة والأسعار -->
                                <RadioButton x:Name="TabRadio2" GroupName="SliderNavGroup"
                                             Style="{StaticResource SliderTabItemStyle}"
                                             Click="TabRadio_Click" Tag="2">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="FileSpreadsheet" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TabPricingGrid, FallbackValue='جدول المقايسة والأسعار'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Tab 3: أسعار المشاريع -->
                                <RadioButton x:Name="TabRadio3" GroupName="SliderNavGroup"
                                             Style="{StaticResource SliderTabItemStyle}"
                                             Click="TabRadio_Click" Tag="3">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Database" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TabProjectRates, FallbackValue='أسعار المشاريع'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Tab 4: تصدير الملف -->
                                <RadioButton x:Name="TabRadio4" GroupName="SliderNavGroup"
                                             Style="{StaticResource SliderTabItemStyle}"
                                             Click="TabRadio_Click" Tag="4">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Download" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TabExport, FallbackValue='تصدير الملف'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Interactive SliderBar Track (المؤشر المنزلق التفاعلي) -->
                    <Slider x:Name="NavSlider"
                            Style="{StaticResource ModernNavSliderStyle}"
                            Minimum="0" Maximum="4" SmallChange="1" LargeChange="1"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="NavSlider_ValueChanged"
                            Height="10" Margin="32,2,32,0" Cursor="Hand"
                            ToolTip="تحريك الشريط للتنقل السريع بين القوائم"/>
                </StackPanel>
            </Border>

            <!-- Language Switcher, Theme Switcher & Offline Badge -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Subtle Cohesive Offline Badge -->
                <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ShieldCheck" Width="14" Height="14" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LblOfflineBadge, FallbackValue='نظام محلي معزول ١٠٠٪'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Theme Switcher (Dark / Light Mode) -->
                <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource SecondaryBtn}" Padding="10,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="{Binding ThemeIcon}" Width="15" Height="15" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ThemeText}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Language Switcher Button -->
                <Button Command="{Binding ToggleLanguageCommand}" Style="{StaticResource SecondaryBtn}" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Languages" Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentLanguageCode}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
