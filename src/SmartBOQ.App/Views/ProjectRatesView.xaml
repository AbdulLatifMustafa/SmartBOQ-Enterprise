<UserControl x:Class="SmartBOQ.App.Views.ProjectRatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header Section -->
            <RowDefinition Height="Auto"/>
            <!-- KPI Summary Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Search & Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Historical Items DataGrid (Fills Available Height) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: HEADER & REPOSITORY BADGE                                          -->
        <!-- ========================================================================= -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Database" Width="20" Height="20" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="قاعدة بيانات الأسعار المرجعية والسجلات التاريخية (SQLite)" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="أرشفة فورية لجميع البنود المسعرة عند كل عملية تصدير مع محرك بحث ذكي فوري بالاسم، الفاتورة، والملف." 
                           FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="30,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding OpenDatabaseLocationCommand}" Style="{StaticResource SecondaryBtn}" Padding="10,5" Margin="0,0,8,0"
                        ToolTip="{Binding DatabaseFilePath, StringFormat={}فتح موقع قاعدة البيانات: {0}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="HardDrive" Width="13" Height="13" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="موقع قاعدة البيانات (بجانب الـ EXE)" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ShieldCheck" Width="14" Height="14" Foreground="{DynamicResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="مستودع محلي 100%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>
                <Button Command="{Binding RefreshHistoricalCommand}" Style="{StaticResource SecondaryBtn}" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="RotateCw" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تحديث" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ========================================================================= -->
        <!-- ROW 1: KPI SUMMARY CARDS                                                  -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Results Count -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="النتائج المطابقة" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding HistoricalTotalCount, StringFormat={}{0:N0} بند}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BrushBgCardHover}" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="ListOrdered" Width="16" Height="16" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Average Rate -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="0,0,10,0" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="متوسط السعر للنتائج" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding HistoricalAvgRate, StringFormat={}{0:N2} EGP}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource BrushSuccess}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BrushBgCardHover}" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="Coins" Width="16" Height="16" Foreground="{DynamicResource BrushSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Latest Pricing Date -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="0,0,10,0" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="أحدث تاريخ تسعير" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding HistoricalLatestDate}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BrushBgCardHover}" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="Calendar" Width="16" Height="16" Foreground="{DynamicResource BrushInfo}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Local Storage Engine -->
            <Border Grid.Column="3" Style="{StaticResource ModernCard}" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="محرك الاستعلام" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="SQLite WAL Indexed" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BrushBgCardHover}" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="HardDrive" Width="16" Height="16" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 2: SEARCH & FILTER BAR                                                -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input with Clear Button -->
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding HistoricalSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" 
                             FontSize="13.5" 
                             Padding="12,8,36,8"/>
                    
                    <!-- Search Icon / Placeholder Hint inside TextBox -->
                    <iconPacks:PackIconLucide Kind="Search" Width="16" Height="16" Foreground="{DynamicResource BrushTextSecondary}" 
                                             HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <!-- Search Button -->
                <Button Grid.Column="1" Command="{Binding SearchHistoricalCommand}" Style="{StaticResource ModernBtn}" Margin="10,0,0,0" Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Search" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="بحث ذكي في السجلات" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Clear Button -->
                <Button Grid.Column="2" Command="{Binding ClearHistoricalSearchCommand}" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="مسح" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 3: HISTORICAL PRICED ITEMS DATAGRID                                   -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="0">
            <Grid>
                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding HistoricalSearchResults}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          Background="{DynamicResource BrushBgCard}"
                          RowBackground="{DynamicResource BrushRowBg}"
                          AlternatingRowBackground="{DynamicResource BrushRowAltBg}"
                          BorderThickness="0"
                          Foreground="{DynamicResource BrushTextPrimary}"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{DynamicResource BrushBorder}"
                          VerticalGridLinesBrush="{DynamicResource BrushBorder}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <!-- Project / Invoice Column -->
                        <DataGridTextColumn Header="المشروع / الفاتورة" Binding="{Binding InvoiceName}" Width="1.4*" MinWidth="120"/>

                        <!-- Source File Column -->
                        <DataGridTextColumn Header="اسم الملف المصدر" Binding="{Binding SourceFileName}" Width="1.5*" MinWidth="130"/>

                        <!-- Export Date Column -->
                        <DataGridTextColumn Header="تاريخ التصدير" Binding="{Binding FormattedDate}" Width="1.2*" MinWidth="110"/>

                        <!-- Item Code Column -->
                        <DataGridTextColumn Header="رمز البند" Binding="{Binding ItemCode}" Width="0.9*" MinWidth="80"/>

                        <!-- Description Column -->
                        <DataGridTextColumn Header="بيان الأعمال والمواصفة" Binding="{Binding Description}" Width="3.2*" MinWidth="240"/>

                        <!-- Unit Column -->
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="0.8*" MinWidth="60"/>

                        <!-- Quantity Column -->
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="1*" MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Unit Rate Column (Highlighted) -->
                        <DataGridTemplateColumn Header="السعر المعتمد" Width="1.3*" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedRate}" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Total Amount Column -->
                        <DataGridTemplateColumn Header="الإجمالي" Width="1.4*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedAmount}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Open in Excel Column -->
                        <DataGridTemplateColumn Header="الموقع" Width="1*" MinWidth="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenHistoricalItemLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryBtn}"
                                            Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            ToolTip="فتح موقع هذا البند في ملف Excel">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="ExternalLink" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="فتح" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Overlay when no results are found -->
                <Border Background="{DynamicResource BrushBgCard}" 
                        Visibility="{Binding HasNoHistoricalResults, Converter={StaticResource BoolToVis}}"
                        Padding="40">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushBgCardHover}" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <iconPacks:PackIconLucide Kind="SearchX" Width="24" Height="24" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="لا توجد نتائج مطابقة لبحثك في السجلات التاريخية" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="جرب البحث بكلمات أخرى، اسم الفاتورة، كود البند، أو جزء من الوصف" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
