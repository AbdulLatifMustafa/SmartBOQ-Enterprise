<UserControl x:Class="SmartBOQ.App.Views.FileCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:compare="clr-namespace:SmartBOQ.App.Views.Compare"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200">
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header / Title Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Sub-navigation Tabs Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Sub-view Workspace hosting isolated modular tabs -->
            <RowDefinition Height="*"/>
            <!-- Row 3: Bottom Persistent Action Footer Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: TOP HEADER WITH REAL-TIME METRICS                                   -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,8,0">
                            <iconPacks:PackIconLucide Kind="GitCompare" Width="17" Height="17" Foreground="{DynamicResource BrushPrimary}"/>
                        </Border>
                        <TextBlock Text="مقارنة ومطابقة المقايسات" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="محاذاة شيتات المقاول والاستشاري وتوجيه مسارات الأعمدة وتدقيق الأسعار." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="31,2,0,0"/>
                </StackPanel>

                <!-- Quick Real-Time Metrics Strip (Responsive WrapPanel) -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,2,6,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="FileSpreadsheet" Width="13" Height="13" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IngestedFiles.Count, StringFormat={}{0} ملفات}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,2,6,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Layers" Width="13" Height="13" Foreground="{DynamicResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalDiscoveredTablesCount, StringFormat={}{0} جدول}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,2,6,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="GitMerge" Width="13" Height="13" Foreground="{DynamicResource BrushInfo}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalLinkedTablesCount, StringFormat={}{0} مرتبط}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ShieldCheck" Width="13" Height="13" Foreground="{DynamicResource BrushWarning}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalShieldedTablesCount, StringFormat={}{0} مبالغ احتياطية}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: SLEEK SUB-NAVIGATION TABS BAR WITH SLIDERBAR SCROLLVIEWER          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,12">
            <ScrollViewer Style="{StaticResource MenuSliderBarStyle}">
                <Grid MinWidth="600">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tab 0: Files & Tables -->
                    <Button Grid.Column="0" Command="{Binding SetCompareSubTabCommand}" CommandParameter="0" Height="38" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="6" Padding="10,6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedCompareSubTab}" Value="0">
                                        <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="FolderTree" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="1. استكشاف وبنية الملفات" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Tab 1: Sheet Linker -->
                    <Button Grid.Column="1" Command="{Binding SetCompareSubTabCommand}" CommandParameter="1" Height="38" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="6" Padding="10,6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedCompareSubTab}" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="GitMerge" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="2. محاذاة وربط الشيتات" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Tab 2: Column Routing Channels -->
                    <Button Grid.Column="2" Command="{Binding SetCompareSubTabCommand}" CommandParameter="2" Height="38" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="6" Padding="10,6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedCompareSubTab}" Value="2">
                                        <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="ArrowRightLeft" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="3. توجيه قنوات الأعمدة" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 2: MODULAR SUB-VIEW WORKSPACE                                         -->
        <!-- ========================================================================= -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedCompareSubTab}" BorderThickness="0" Background="Transparent" Margin="0,0,0,10">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- SUB-TAB 0: Files & Tables Discovery -->
            <TabItem>
                <compare:FilesDiscoveryTab/>
            </TabItem>

            <!-- SUB-TAB 1: Smart Sheet & Table Linker -->
            <TabItem>
                <compare:SheetLinkerTab/>
            </TabItem>

            <!-- SUB-TAB 2: Column Channel Routing -->
            <TabItem>
                <compare:ColumnChannelsTab/>
            </TabItem>
        </TabControl>

        <!-- ========================================================================= -->
        <!-- ROW 3: BOTTOM PERSISTENT ACTION FOOTER BAR                                -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Action Buttons (Responsive WrapPanel) -->
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Verify Button -->
                    <Button Command="{Binding VerifyCommand}" Style="{StaticResource SecondaryBtn}" Padding="13,7" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ShieldCheck" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="فحص وتحليل الجداول مسبقاً" FontWeight="SemiBold" FontSize="12.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Reconcile Button -->
                    <Button Command="{Binding ReconcileCommand}" Style="{StaticResource SecondaryBtn}" Padding="14,7" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Table" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="بدء المطابقة الذكية وتنفيذ الخطة" FontWeight="Bold" FontSize="12.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Direct Merge & Export Button (Refined Elevated Windows Style) -->
                    <Button Command="{Binding ReconcileAndExportCommand}" Style="{StaticResource SuccessBtn}" Padding="16,7" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Download" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="بدء الدمج والتسعير والتصدير الفوري" FontWeight="Bold" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Right Status Message Indicator (Neutral Eye-Comfort Tag) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ShieldCheck" Width="13" Height="13" Foreground="{DynamicResource BrushSuccess}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="جاهز للتسعير والربط" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
