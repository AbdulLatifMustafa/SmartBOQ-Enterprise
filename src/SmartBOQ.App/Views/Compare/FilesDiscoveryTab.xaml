<UserControl x:Class="SmartBOQ.App.Views.Compare.FilesDiscoveryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left: Registered Files & Drag-Drop Zone (Responsive) -->
            <ColumnDefinition Width="320" MinWidth="240" MaxWidth="460"/>
            <ColumnDefinition Width="6"/>
            <!-- Right: Tables & Sheets Inspector (Fills remaining width) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- LEFT: INGESTED FILES & DRAG-AND-DROP RECEPTOR                             -->
        <!-- ========================================================================= -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,4,0" Padding="14"
                AllowDrop="True" Drop="FilesDropZone_Drop" DragOver="FilesDropZone_DragOver">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="الملفات المسجلة" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IngestedFiles.Count, StringFormat={}{0} ملف}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </Border>
                    </StackPanel>

                    <Button Command="{Binding AddNewFileCommand}" Style="{StaticResource ModernBtn}" Padding="12,6" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Plus" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إضافة ملف Excel" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Empty State Drop Zone when no files are loaded -->
                <Border Grid.Row="1" Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5" CornerRadius="10" Padding="20"
                        Visibility="{Binding HasNoIngestedFiles, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <iconPacks:PackIconLucide Kind="FileSpreadsheet" Width="28" Height="28" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="لا توجد ملفات مقايسة مضافة بعد" FontWeight="Bold" FontSize="14.5" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="اسحب ملفات المقاول والاستشاري إلى هنا&#x0a;أو اضغط على الزر أدناه لاختيار الملفات" TextAlignment="Center" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,14"/>
                        <Button Command="{Binding AddNewFileCommand}" Style="{StaticResource ModernBtn}" Padding="16,8" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Plus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="استعراض وإضافة ملفات..." FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Files Scroll List when files are loaded -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasIngestedFiles, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding IngestedFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Role Badge and Actions -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="{Binding RoleBadgeBackground}">
                                                <TextBlock Text="{Binding RoleBadgeText}" FontWeight="Bold" FontSize="11" Foreground="{Binding RoleBadgeColor}"/>
                                            </Border>

                                            <!-- Card Control Buttons -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <!-- Inspect Button -->
                                                <Button Command="{Binding DataContext.InspectFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip="استعراض شيتات وجداول هذا الملف"
                                                        Background="Transparent" BorderThickness="0" Padding="4" Margin="0,0,4,0" Cursor="Hand">
                                                    <iconPacks:PackIconLucide Kind="Eye" Width="14" Height="14" Foreground="{DynamicResource BrushPrimary}"/>
                                                </Button>

                                                <!-- Remove File Button -->
                                                <Button Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip="حذف الملف من المقارنة"
                                                        Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
                                                    <iconPacks:PackIconLucide Kind="Trash2" Width="14" Height="14" Foreground="{DynamicResource BrushDanger}"/>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Row 1: File Name & Stats -->
                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                            <TextBlock Text="{Binding FileSizeFormatted, StringFormat={}الحجم: {0}}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Row 2: Metrics & Reassign Role Buttons -->
                                        <DockPanel Grid.Row="2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#15FFFFFF" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding SheetsCount, StringFormat={}{0} شيت}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                </Border>
                                                <Border Background="#15FFFFFF" CornerRadius="3" Padding="5,2">
                                                    <TextBlock Text="{Binding TotalEstimatedItems, StringFormat={}{0:N0} بند}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Command="{Binding DataContext.SetPrimaryContractorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="تعيين كملف المقاول الأساسي (المسعر)"
                                                        Style="{StaticResource SecondaryBtn}" Padding="6,2" FontSize="10" Margin="0,0,4,0">
                                                    <TextBlock Text="مقاول"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.SetPrimaryConsultantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="تعيين كملف الاستشاري المستهدف (المطلوب تسعيره)"
                                                        Style="{StaticResource SecondaryBtn}" Padding="6,2" FontSize="10">
                                                    <TextBlock Text="استشاري"/>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Drag-Drop Hint Footer -->
                <Border Grid.Row="2" Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="Upload" Width="13" Height="13" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="يمكنك سحب وإفلات أي عدد من ملفات Excel هنا مباشرة" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- GridSplitter between Files and Tables for Responsive Flexibility -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- ========================================================================= -->
        <!-- RIGHT: DISCOVERED TABLES INSPECTOR                                        -->
        <!-- ========================================================================= -->
        <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Inspector Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Layers" Width="16" Height="16" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الجداول المكتشفة في الملف المحدد: " FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="6,0,0,0">
                                <TextBlock Text="{Binding SelectedFileForDetails.FileName, FallbackValue='(اختر ملفاً لعرض جداوله)'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="كشف ذكي لأوراق العمل، نطاقات الأسعار، وتصنيف جداول المقايسة والمبالغ الاحتياطية." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding TotalDiscoveredItemsCount, StringFormat={}{0:N0} بند إجمالي}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </Border>
                        <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding InspectedSheets.Count, StringFormat={}{0} جدول}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Responsive Tables Grid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding InspectedSheets}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          Background="{DynamicResource BrushBgCard}"
                          RowBackground="{DynamicResource BrushRowBg}"
                          AlternatingRowBackground="{DynamicResource BrushRowAltBg}"
                          BorderBrush="{DynamicResource BrushBorder}"
                          BorderThickness="1"
                          Foreground="{DynamicResource BrushTextPrimary}"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{DynamicResource BrushBorder}"
                          VerticalGridLinesBrush="{DynamicResource BrushBorder}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم ورقة العمل / الجدول" Binding="{Binding SheetName}" Width="2.4*" MinWidth="150"/>
                        <DataGridTextColumn Header="رمز الباب (Bill Code)" Binding="{Binding BillCode}" Width="1*" MinWidth="85"/>
                        <DataGridTextColumn Header="تصنيف الجدول" Binding="{Binding TypeBadgeText}" Width="1.5*" MinWidth="120"/>
                        <DataGridTextColumn Header="البنود التقديرية" Binding="{Binding EstimatedRows, StringFormat={}{0:N0} بند}" Width="1*" MinWidth="85"/>
                        <DataGridTextColumn Header="العملة" Binding="{Binding DetectedCurrency}" Width="0.8*" MinWidth="65"/>

                        <!-- Action Column: Direct Excel Jump -->
                        <DataGridTemplateColumn Header="الموقع في الملف" Width="1.2*" MinWidth="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenSheetLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource SecondaryBtn}" 
                                            Padding="6,3" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            ToolTip="فتح هذا الجدول مباشرة في Excel">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="ExternalLink" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="فتح في Excel" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
