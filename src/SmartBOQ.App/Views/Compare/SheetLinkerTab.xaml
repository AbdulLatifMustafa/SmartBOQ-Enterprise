<UserControl x:Class="SmartBOQ.App.Views.Compare.SheetLinkerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Border Style="{StaticResource ModernCard}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- HEADER TOOLBAR                                                            -->
            <!-- ========================================================================= -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="GitMerge" Width="18" Height="18" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="خريطة محاذاة وربط الشيتات (Topological Sheet Linker)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>
                    <TextBlock Text="ربط كل جدول في مقايسة الاستشاري بالجدول المقابل له في ملف المقاول مع دعم البحث الشامل وحماية الـ PS." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Metrics Pills -->
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2,8,2">
                        <TextBlock Text="{Binding TotalLinkedTablesCount, StringFormat={}{0} جدول مرتبط}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </Border>
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2,10,2">
                        <TextBlock Text="{Binding TotalShieldedTablesCount, StringFormat={}{0} مبالغ احتياطية محمية}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>

                    <!-- Auto Link Action -->
                    <Button Command="{Binding AutoLinkSheetsCommand}" Style="{StaticResource ModernBtn}" Padding="12,6" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Scan" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ربط تلقائي بالذكاء الاصطناعي" FontWeight="Bold" FontSize="12.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Global Search Fallback -->
                    <Button Command="{Binding LinkAllGlobalCommand}" Style="{StaticResource SecondaryBtn}" Padding="12,6" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Globe" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="مطابقة عامة في كامل المقايسة" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>

            <!-- ========================================================================= -->
            <!-- SHEET MAPPING DATAGRID                                                    -->
            <!-- ========================================================================= -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding SheetLinkMappings}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      Background="{DynamicResource BrushBgCard}"
                      RowBackground="{DynamicResource BrushRowBg}"
                      AlternatingRowBackground="{DynamicResource BrushRowAltBg}"
                      BorderBrush="{DynamicResource BrushBorder}"
                      BorderThickness="1"
                      Foreground="{DynamicResource BrushTextPrimary}"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{DynamicResource BrushBorder}"
                      VerticalGridLinesBrush="{DynamicResource BrushBorder}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="جدول الاستشاري (Target Table)" Binding="{Binding TargetSheetName}" Width="2*" MinWidth="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="رمز الباب" Binding="{Binding TargetBillCode}" Width="0.8*" MinWidth="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="البنود التقديرية" Binding="{Binding TargetItemCount, StringFormat={}{0:N0} بند}" Width="0.9*" MinWidth="80" IsReadOnly="True"/>
                    
                    <!-- Status Badge Column -->
                    <DataGridTemplateColumn Header="حالة الحماية والربط" Width="1.3*" MinWidth="120" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBadgeBackground}" 
                                        BorderBrush="{Binding StatusBadgeBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusBadgeText}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding StatusBadgeColor}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Source Mapping ComboBox Column -->
                    <DataGridTemplateColumn Header="جدول المقاول المرتبط (Source Table)" Width="2.2*" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableSourceOptions}"
                                          SelectedItem="{Binding SelectedSourceSheet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsNotProvisionalSum}"
                                          Style="{StaticResource ModernComboBox}" Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Direct Excel Table Jump Column -->
                    <DataGridTemplateColumn Header="الانتقال للموقع في Excel" Width="1.4*" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.OpenLinkedSheetLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource ModernBtn}" 
                                            Padding="6,3" Margin="0,0,4,0" 
                                            ToolTip="فتح جدول الاستشاري المستهدف في Excel">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="FileSpreadsheet" Width="11" Height="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="المستهدف" FontSize="10.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.OpenLinkedSourceSheetLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource SecondaryBtn}" 
                                            Padding="6,3" 
                                            IsEnabled="{Binding IsNotProvisionalSum}" 
                                            ToolTip="فتح جدول المقاول المصدر في Excel">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="ExternalLink" Width="11" Height="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="المصدر" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
