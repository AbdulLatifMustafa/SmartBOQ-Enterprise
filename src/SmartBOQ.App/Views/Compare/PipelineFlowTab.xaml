<UserControl x:Class="SmartBOQ.App.Views.Compare.PipelineFlowTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Canvas Header Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Visual Workflow Canvas -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Live Parameters & Safeguards Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Infographic KPI Cards -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: WORKFLOW CANVAS HEADER                                             -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="14,10">
            <DockPanel>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,8,0">
                            <iconPacks:PackIconLucide Kind="Workflow" Width="17" Height="17" Foreground="{DynamicResource BrushPrimary}"/>
                        </Border>
                        <TextBlock Text="مخطط مسار العمليات (Workflow Pipeline)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="محرك المعالجة والربط" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="مخطط سريان ومعالجة البيانات لحظياً عبر المراحل من فحص الملفات وحتى التصدير النهائي." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="31,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Execute Button (Windows 11 Dark Elevated Style) -->
                    <Button Command="{Binding ReconcileCommand}" Style="{StaticResource ModernBtn}" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Play" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تشغيل مسار المعالجة والتسعير" FontWeight="Bold" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: VISUAL WORKFLOW CANVAS (HORIZONTAL CONNECTED NODES)                 -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
            <ScrollViewer Style="{StaticResource MenuSliderBarStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Node 1: Inputs -->
                        <ColumnDefinition Width="195"/>
                        <!-- Connector 1->2 -->
                        <ColumnDefinition Width="42"/>
                        <!-- Node 2: Tables -->
                        <ColumnDefinition Width="195"/>
                        <!-- Connector 2->3 -->
                        <ColumnDefinition Width="42"/>
                        <!-- Node 3: Sheet Linker -->
                        <ColumnDefinition Width="195"/>
                        <!-- Connector 3->4 -->
                        <ColumnDefinition Width="42"/>
                        <!-- Node 4: SIMD Matcher -->
                        <ColumnDefinition Width="195"/>
                        <!-- Connector 4->5 -->
                        <ColumnDefinition Width="42"/>
                        <!-- Node 5: Live Export -->
                        <ColumnDefinition Width="195"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================================================================= -->
                    <!-- NODE 1: DATA INPUTS (مصادر الملفات)                                -->
                    <!-- ================================================================= -->
                    <Grid Grid.Column="0">
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <!-- Node Header -->
                                <DockPanel Margin="0,0,0,10">
                                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center">
                                        <iconPacks:PackIconLucide Kind="FileSpreadsheet" Width="14" Height="14" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="1. مصادر المقايسة" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Data Ingestion" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Node Body Stats -->
                                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding IngestedFiles.Count, StringFormat={}{0} ملفات نشطة}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="ملفات المقاول والاستشاري" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Node Status Badge -->
                                <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="● جاهز" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right Output Socket (Pin) -->
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimary}" Stroke="{DynamicResource BrushBgDark}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-5,0"/>
                    </Grid>

                    <!-- CONNECTOR 1 -> 2 -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Rectangle Height="1.5" Fill="{DynamicResource BrushBorder}" VerticalAlignment="Center"/>
                        <iconPacks:PackIconLucide Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ================================================================= -->
                    <!-- NODE 2: SCHEMA & TABLES (كشف الجداول)                             -->
                    <!-- ================================================================= -->
                    <Grid Grid.Column="2">
                        <!-- Left Input Socket (Pin) -->
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimary}" Stroke="{DynamicResource BrushBgDark}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0"/>

                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center">
                                        <iconPacks:PackIconLucide Kind="Layers" Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="2. استكشاف الجداول" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Table Discovery" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalDiscoveredTablesCount, StringFormat={}{0} جدول مكتشف}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding TotalDiscoveredItemsCount, StringFormat={}{0:N0} بند تقديري}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="● تم الكشف" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right Output Socket (Pin) -->
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimary}" Stroke="{DynamicResource BrushBgDark}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-5,0"/>
                    </Grid>

                    <!-- CONNECTOR 2 -> 3 -->
                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <Rectangle Height="1.5" Fill="{DynamicResource BrushBorder}" VerticalAlignment="Center"/>
                        <iconPacks:PackIconLucide Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ================================================================= -->
                    <!-- NODE 3: SHEET & TABLE LINKER (محاذاة الشيتات)                       -->
                    <!-- ================================================================= -->
                    <Grid Grid.Column="4">
                        <!-- Left Input Socket (Pin) -->
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimary}" Stroke="{DynamicResource BrushBgDark}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0"/>

                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center">
                                        <iconPacks:PackIconLucide Kind="GitMerge" Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="3. محاذاة الشيتات" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Topology Alignment" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalLinkedTablesCount, StringFormat={}{0} جدول مرتبط}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding TotalShieldedTablesCount, StringFormat={}{0} شيت PS محمي}" FontSize="10" Foreground="{DynamicResource BrushWarning}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="● محاذاة مؤكدة" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right Output Socket (Pin) -->
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimary}" Stroke="{DynamicResource BrushBgDark}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-5,0"/>
                    </Grid>

                    <!-- CONNECTOR 3 -> 4 -->
                    <Grid Grid.Column="5" VerticalAlignment="Center">
                        <Rectangle Height="1.5" Fill="{DynamicResource BrushBorder}" VerticalAlignment="Center"/>
                        <iconPacks:PackIconLucide Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ================================================================= -->
                    <!-- NODE 4: SIMD VECTOR MATCHER (محرك المطابقة)                        -->
                    <!-- ================================================================= -->
                    <Grid Grid.Column="6">
                        <!-- Left Input Socket (Pin) -->
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushWarning}" Stroke="{DynamicResource BrushBgDark}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0"/>

                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center">
                                        <iconPacks:PackIconLucide Kind="Cpu" Width="14" Height="14" Foreground="{DynamicResource BrushWarning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="4. مطابقة وتدقيق الأسعار" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Vector SIMD Matching" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sensitivity, StringFormat={}حساسية المطابقة: {0:P0}}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="معالجة متوازية متعددة الخيوط" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="● فائق السرعة O(1)" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource BrushWarning}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right Output Socket (Pin) -->
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushWarning}" Stroke="{DynamicResource BrushBgDark}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-5,0"/>
                    </Grid>

                    <!-- CONNECTOR 4 -> 5 -->
                    <Grid Grid.Column="7" VerticalAlignment="Center">
                        <Rectangle Height="1.5" Fill="{DynamicResource BrushBorder}" VerticalAlignment="Center"/>
                        <iconPacks:PackIconLucide Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ================================================================= -->
                    <!-- NODE 5: LIVE EXCEL ENGINE (مخرجات Excel الحية)                    -->
                    <!-- ================================================================= -->
                    <Grid Grid.Column="8">
                        <!-- Left Input Socket (Pin) -->
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushPrimary}" Stroke="{DynamicResource BrushBgDark}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0"/>

                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center">
                                        <iconPacks:PackIconLucide Kind="FileSpreadsheet" Width="14" Height="14" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="5. مخرجات Excel الحية" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Live Dynamic Formulas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="صيغ ديناميكية + تدقيق" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="حفظ 100% من معادلات الاستشاري" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="● جاهز للإنشاء" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 2: LIVE TUNING BAR & SAFEGUARDS                                       -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Sensitivity Slider -->
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="20"/>
                    <!-- Scope Strategy Radios -->
                    <ColumnDefinition Width="*"/>
                    <!-- Safeguards Badges -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sensitivity Slider -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="حساسية المطابقة:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding Sensitivity, StringFormat={}{0:P0}}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider Minimum="0.50" Maximum="1.0" Value="{Binding Sensitivity, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.10" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <!-- Scope Strategy Switch -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="نطاق البحث عن الأسعار:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="ScopeStrategyGroup" IsChecked="True" Content="عزل صارم حسب الباب" Style="{StaticResource SubNavTabStyle}" Margin="0,0,10,0"/>
                        <RadioButton GroupName="ScopeStrategyGroup" Content="سماح بالبحث الشامل (Global)" Style="{StaticResource SubNavTabStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Safeguards Badges (Neutral Eye-Comfort) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ShieldCheck" Width="14" Height="14" Foreground="{DynamicResource BrushWarning}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="حماية الـ PS: نشطة" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="CheckCheck" Width="14" Height="14" Foreground="{DynamicResource BrushSuccess}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="عزل العملات: صارم" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 3: INFOGRAPHIC KPI STATS SUMMARY CARDS (Responsive UniformGrid)         -->
        <!-- ========================================================================= -->
        <UniformGrid Grid.Row="3" Columns="4">
            <!-- Card 1 -->
            <Border Style="{StaticResource ModernCard}" Padding="12,10" Margin="0,0,6,0">
                <DockPanel>
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="Zap" Width="16" Height="16" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="سرعة المعالجة" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="فورية &lt; 2 ثانية" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 2 -->
            <Border Style="{StaticResource ModernCard}" Padding="12,10" Margin="6,0,6,0">
                <DockPanel>
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="Target" Width="16" Height="16" Foreground="{DynamicResource BrushSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="أولوية كود البند" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="تطابق حتمي تام" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 3 -->
            <Border Style="{StaticResource ModernCard}" Padding="12,10" Margin="6,0,6,0">
                <DockPanel>
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="ShieldCheck" Width="16" Height="16" Foreground="{DynamicResource BrushWarning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="المبالغ الاحتياطية" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="محمية بنسبة 100%" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 4 -->
            <Border Style="{StaticResource ModernCard}" Padding="12,10" Margin="6,0,0,0">
                <DockPanel>
                    <Border Background="{DynamicResource BrushBgCardHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="FileText" Width="16" Height="16" Foreground="{DynamicResource BrushInfo}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="تقرير التدقيق المالي" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="كشف فروق لحظي" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
