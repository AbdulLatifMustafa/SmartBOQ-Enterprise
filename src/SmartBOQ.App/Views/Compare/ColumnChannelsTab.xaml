<UserControl x:Class="SmartBOQ.App.Views.Compare.ColumnChannelsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Border Style="{StaticResource ModernCard}" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Section Title & Action -->
                <DockPanel Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ArrowRightLeft" Width="18" Height="18" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ربط وتوجيه قنوات الأعمدة والتسعير (Column Channel Routing)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock Text="تحديد قنوات سحب الأسعار والمواصفات من ملف المقاول وحقنها في أعمدة مقايسة الاستشاري بدقة رقمية." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Command="{Binding AutoDetectColumnsCommand}" Style="{StaticResource SecondaryBtn}" Padding="14,8" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Scan" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="كشف وتعيين الأعمدة تلقائياً" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Channel 1: Unit Rate (سعر الوحدة) -->
                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="1. عمود سعر الوحدة (Unit Rate)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="القناة الأساسية لحقن الأسعار" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="عمود السعر في ملف المقاول (Source):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableSourceColumns}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedSourceRateCol, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>

                        <iconPacks:PackIconLucide Grid.Column="2" Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="عمود السعر المستهدف في الاستشاري (Target):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableTargetColumns}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedTargetRateCol, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Channel 2: Description (وصف البند) -->
                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="2. وصف البند (Description)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="المقارنة النصية والتحليل المتجهي" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="عمود الوصف في ملف المقاول (Source):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableSourceColumns}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedSourceDescCol, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>

                        <iconPacks:PackIconLucide Grid.Column="2" Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="عمود الوصف المستهدف في الاستشاري (Target):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableTargetColumns}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedTargetDescCol, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Channel 3: Item Code (كود البند) -->
                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="3. كود البند (Item Code / No)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="التطابق الحتمي الأولي (Tier 1)" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="عمود الكود في ملف المقاول (Source):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableSourceColumns}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedSourceCodeCol, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>

                        <iconPacks:PackIconLucide Grid.Column="2" Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="عمود الكود المستهدف في الاستشاري (Target):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableTargetColumns}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedTargetCodeCol, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Channel 4: Quantity (الكمية) -->
                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="4. الكمية المقاسة (Quantity)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="حساب إجمالي البند والتحقق الرياضي" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="عمود الكمية في ملف المقاول (Source):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableSourceColumns}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedSourceQtyCol, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>

                        <iconPacks:PackIconLucide Grid.Column="2" Kind="ArrowLeft" Width="20" Height="20" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="عمود الكمية المستهدف في الاستشاري (Target):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableTargetColumns}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedTargetQtyCol, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Channel 5: Unit (وحدة القياس) -->
                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="٥. وحدة القياس (Unit of Measure)" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="التحقق من توافق الوحدات (m2/m3/nr)" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="عمود الوحدة في ملف المقاول (Source):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableSourceColumns}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedSourceUnitCol, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>

                        <iconPacks:PackIconLucide Grid.Column="2" Kind="ArrowLeft" Width="20" Height="20" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="عمود الوحدة المستهدف في الاستشاري (Target):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableTargetColumns}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedTargetUnitCol, Mode=TwoWay}" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Channel Routing Preview Badge -->
                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="CheckCheck" Width="16" Height="16" Foreground="{DynamicResource BrushSuccess}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="معاينة مسار البيانات: " FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SampleRoutedDataText}" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
